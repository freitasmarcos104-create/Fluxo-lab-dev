{
  "name": "fluxo-lab-desktop",
  "version": "0.1.5",
  "description": "Aplicativo desktop do Fluxo Lab",
  "main": "main.js",
  "private": true,
  "author": "Markfree",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "test:ui": "node --test tests/glass-neon.test.mjs"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "br.com.markfree.fluxolab",
    "productName": "Fluxo Lab",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "glass-neon-buttons.css",
      "config.json",
      "package.json",
      "assets/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "assets/fluxolab.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fluxo Lab",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Fluxo-Lab-Portable-${version}.${ext}"
    }
  },
  "engines": {
    "node": ">=22 <23"
  }
}
